generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

generator zod {
  provider = "prisma-zod-generator"
  output   = "../src/generated/zod"
  config   = "./zod-generator.config.json"
}

datasource db {
  provider = "sqlite"
}

enum DecisionType {
  ban
  captcha
  whitelist
}

// Decision.origin is a plain string: LAPI also emits CAPI, lists, console and
// cscli-import, and an enum would reject those rows outright.

enum AlertEntryType {
  paths
  ports
  usernames
  rules
  none
}

model User {
  id              String    @id
  name            String
  email           String    @unique
  emailVerified   Boolean   @default(false)
  image           String?
  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt
  username        String?   @unique
  displayUsername String?
  sessions        Session[]
  accounts        Account[]
}

model Session {
  id        String   @id
  expiresAt DateTime
  token     String   @unique
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  ipAddress String?
  userAgent String?
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model Account {
  id                    String    @id
  accountId             String
  providerId            String
  userId                String
  user                  User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  accessToken           String?
  refreshToken          String?
  idToken               String?
  accessTokenExpiresAt  DateTime?
  refreshTokenExpiresAt DateTime?
  scope                 String?
  password              String?
  createdAt             DateTime  @default(now())
  updatedAt             DateTime  @updatedAt
}

model Verification {
  id         String   @id
  identifier String
  value      String
  expiresAt  DateTime
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt
}

model Host {
  id        String   @id @default(cuid())
  ip        String   @unique
  scope     String   @default("Ip") // Ip, Range, etc.
  firstSeen DateTime @default(now())
  lastSeen  DateTime
  totalBans Int      @default(0)

  // GeoIP enrichment (from alerts API source data)
  country   String?
  asNumber  String?
  asName    String?
  latitude  Float?
  longitude Float?

  decisions Decision[]
  alerts    Alert[]
}

model Decision {
  id         Int      @id // CrowdSec decision ID
  hostIp     String
  host       Host     @relation(fields: [hostIp], references: [ip])

  type       DecisionType    // ban, captcha
  origin     String          // crowdsec, cscli, CAPI, lists, console…
  uuid       String?
  scenario   String
  duration   String   // original duration (e.g. "4h")
  scope      String   @default("Ip")    // Ip, Range, Country
  simulated  Boolean  @default(false)  // reported by LAPI, enforced by nobody
  createdAt  DateTime @default(now())
  expiresAt  DateTime? // calculated: createdAt + duration
  active     Boolean  @default(true)
  alerts     Alert[]  @relation("DecisionAlerts")

  @@index([hostIp])
  @@index([active])
  @@index([expiresAt])
  @@index([active, createdAt]) // retention prunes oldest-inactive-first
}

model Alert {
  id          Int      @id // CrowdSec Alert ID
  scenario    String
  message     String
  createdAt   DateTime
  entries     String         @default("[]") // JSON string[] of event highlights
  entryType   AlertEntryType @default(none) // discriminates what entries[] contains

  // Attack window: tells a burst scanner from a slow crawler
  startAt     DateTime?
  stopAt      DateTime?
  eventsCount Int? // LAPI's count, can exceed events[]

  // Link to Host
  hostIp      String
  host        Host     @relation(fields: [hostIp], references: [ip])

  // Link to Decisions (many-to-many)
  decisions   Decision[] @relation("DecisionAlerts")

  // Provenance: which agent saw it, and the bucket that fired
  integration String? // resolved by the parser registry: traefik-http, appsec…
  machineId   String? // traefik, opnsense, nextcloud…
  uuid        String?
  scenarioVersion String?
  capacity    Int? // bucket size; with leakspeed, burst vs slow crawl
  leakspeed   String?
  simulated   Boolean  @default(false)
  remediation Boolean?
  sourceScope String?
  sourceRange String? // e.g. 136.112.0.0/13, for same-range correlation

  // Store raw logs as JSON because they are unstructured
  events      String   @default("[]") // JSON string of the log lines
  // Alert-level aggregates (ja4h, user_agent, dst_port…), JSON key → string
  meta        String   @default("{}")

  @@index([hostIp])
}