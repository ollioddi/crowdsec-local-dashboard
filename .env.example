# Every variable is documented in docs/configuration.md.
# Never put a "#" comment on the same line as a value: compose keeps it as part
# of the value.

# Generated into the volume when left empty. Required for `pnpm dev`.
BETTER_AUTH_SECRET=

# Set only when serving over HTTPS, so the session cookie is marked Secure.
# BETTER_AUTH_URL=https://dashboard.example.com

# Local development only; the container always uses /data/app.db.
DATABASE_URL=file:./dev.db

# CrowdSec LAPI. Leave empty to run the dashboard without syncing.
# Machine credentials: /etc/crowdsec/local_api_credentials.yaml
# Bouncer token: cscli bouncers add crowdsec-dashboard
# Without the machine credentials there is no alert evidence and no ASN data.
LAPI_URL=
LAPI_MACHINE_ID=
LAPI_MACHINE_PASSWORD=
LAPI_BOUNCER_API_TOKEN=

# Seconds between syncs, and the cap on stored decisions (0 keeps everything).
LAPI_POLL_INTERVAL=60
# Decision origins to pull. Defaults to locally-decided ones; set to an empty
# value to include CAPI and community blocklists (tens of thousands of rows).
LAPI_DECISION_ORIGINS=crowdsec,cscli
# Alerts requested per host when fetching evidence.
LAPI_ALERT_LIMIT=100
DECISION_RETENTION_COUNT=20000
# Also drop inactive decisions older than this many days (0 disables).
DECISION_RETENTION_DAYS=0

UPDATE_CHECK=true
LOG_LEVEL=info
LOG_FORMAT=human

# SSO. Set all three to show the SSO button.
# Redirect URI to register: {BETTER_AUTH_URL}/api/auth/callback/oidc
# OIDC_CLIENT_ID=
# OIDC_CLIENT_SECRET=
# OIDC_ISSUER_URL=
# OIDC_BUTTON_LABEL=
# OIDC_AUTO_REDIRECT=false
