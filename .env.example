# Session signing secret. The container generates one and keeps it in the volume
# when this is empty; `pnpm dev` needs it set. Generate with: openssl rand -base64 32
BETTER_AUTH_SECRET=
# Public URL of the dashboard. Set only behind a reverse proxy that sends the wrong origin.
# BETTER_AUTH_URL=https://dashboard.example.com

# CrowdSec LAPI. Leave empty to run the dashboard without syncing.
LAPI_URL=                 # include the port, e.g. http://192.168.10.75:8080
LAPI_MACHINE_ID=          # from /etc/crowdsec/local_api_credentials.yaml
LAPI_MACHINE_PASSWORD=
LAPI_BOUNCER_API_TOKEN=   # from: cscli bouncers add crowdsec-dashboard
LAPI_POLL_INTERVAL=60     # seconds between syncs
DECISION_RETENTION_COUNT=5000  # max decisions kept; oldest inactive pruned first, 0 keeps everything

# UPDATE_CHECK=false  # stop asking GitHub for the latest release
# LOG_LEVEL=info      # fatal, error, warn, info, debug or trace
# LOG_FORMAT=human    # human for a terminal, json for a log collector

# Local development only; the container always uses /data/app.db
# DATABASE_URL=file:./dev.db

# OIDC/OAuth SSO (optional; set all three to enable the SSO button)
# Redirect URI to register with your provider: {BETTER_AUTH_URL}/api/auth/callback/oidc
# OIDC_CLIENT_ID=
# OIDC_CLIENT_SECRET=
# OIDC_ISSUER_URL=          # e.g. https://authentik.example.com/application/o/my-app/
# OIDC_BUTTON_LABEL=        # default: "Sign in with SSO"
# OIDC_AUTO_REDIRECT=false  # true skips the login form and goes straight to SSO
